<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Base.Theme.StudyMate" parent="Theme.Material3.Light.NoActionBar">

        <item name="colorPrimary">@color/studymate_primary</item>
        <item name="colorOnPrimary">@android:color/white</item>


        <item name="android:windowBackground">@color/studymate_background</item>
        <item name="android:textColorPrimary">@android:color/black</item>
        <item name="android:textColorSecondary">@android:color/black</item>

        <item name="materialButtonStyle">@style/StudyMateButton</item>

    </style>
    <style name="StudyMateButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/black</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">30dp</item>
    </style>

    <style name="Theme.StudyMate" parent="Base.Theme.StudyMate" />


    <style name="textView_style">
        <item name="android:textColor">#474545</item>
    </style>

</resources>
