<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_2"
    tools:context=".MultiLangFragment">


    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="375dp"
        android:layout_height="303dp"
        android:background="@drawable/rounded_layout"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.555"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.471">


        <Button
            android:id="@+id/btnAfrik"
            android:layout_width="339dp"
            android:layout_height="81dp"
            android:layout_marginStart="22dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#0C0275"
            android:text="@string/afrikaans" />

        <Button
            android:id="@+id/btnZulu"
            android:layout_width="339dp"
            android:layout_height="81dp"
            android:layout_marginStart="22dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#0C0275"
            android:text="@string/isizulu" />

        <Button
            android:id="@+id/btnEng"
            android:layout_width="341dp"
            android:layout_height="81dp"
            android:layout_marginStart="22dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#0C0275"
            android:text="@string/english" />
    </LinearLayout>

    <TextView
        android:id="@+id/textView2"
        android:layout_width="314dp"
        android:layout_height="30dp"
        android:fontFamily="sans-serif-condensed-medium"
        android:text="@string/select_a_language_for_application"
        android:textAllCaps="true"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.912" />

    <TextView
        android:id="@+id/btnBackToSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="91dp"
        android:drawablePadding="10dp"
        android:text="@string/settings"
        android:textColor="@color/text_primary"
        android:textSize="25sp"
        android:textStyle="bold"
        app:drawableStartCompat="@drawable/ic_arrow"
        app:layout_constraintBottom_toTopOf="@+id/textView2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.102"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainerView"
        android:layout_width="410dp"
        android:layout_height="730dp"
        android:elevation="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <include
        android:id="@+id/bottomNav"
        layout="@layout/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="76dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        />
</androidx.constraintlayout.widget.ConstraintLayout>