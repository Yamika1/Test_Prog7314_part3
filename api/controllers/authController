const admin = require('../config/firebase');

const register = async (req, res, next) => {
    try{
        
        const {firstName, lastName, username, email, password} = req.body;

        if(!firstName || !lastName || !email || !username|| !password){
            return res.status(400).json({
                error: 'First name, last name, email, and password are required'
            });
        }
    
    
        if(
            typeof firstName !== 'string' ||
            typeof lastName !== 'string' ||
             typeof email !== 'string' ||
              typeof username !== 'string' ||
              typeof password !== 'string' 
        )
        {
 return res.status(400).json({
                error: 'first name, last name, email, username and password must be text values'
            });
        }
        if(password.length < 8){
            return res.status(400).json({
                error: 'Password must be at least 8 characters long'
            })
        }

        const user = await admin.getAuth().createUser({

            email: email.toLowerCase().trim(),
            password: password,
            displayName: `${firstName} ${lastName}`.trim()
        });

        await admin.getAuth().setCustomUserClaims(user.uid, {
            role: 'user'
        });

res.status(201).json({
    message: 'User registered',
    data: {
        id: user.uid,
        firstName: user.displayName.split(' ')[0],
        lastName: user.displayName.split(' ')[1],
        username : user.username,
        email: user.email,
        role: 'user'
    }
});

}
catch (error){
    if (error.code === 'auth/email-already exists'){
        return res.status(409).json({
            error:'User already exists'
        });
    }

    if(error.code === 'auth/invalid-email'){
        return res.status(400).json({
            error: 'Email is invalid'
        });

    }
    next(error);
    }
};

const login = async (req, res, next) => {
try {
const {email, password} = req.body;

if(!email || !password){
    return res.status(400).json({
        error: 'Email and password are required'
    });
}

if(
    typeof email !== 'string' ||
    typeof password !== 'string'
){
    return res.status(400).json({
        error: 'Email and password must be text values'
    });
}

const response = await fetch(
`https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key=${process.env.FIREBASE_API_KEY}`,
 {
    method: 'POST',
    headers: {
        'Content-Type': 'application/json'
    },
    body: JSON.stringify({
        email: email.toLowerCase().trim(),
        password: password,
        returnSecureToken: true
    })
}

)

const data = await response.json();

 
if(!response.ok){
    if(
        data.error.message === 'EMAIL_NOT_FOUND' ||
        data.error.message === 'INVALID_PASSWORD' ||
        data.error.message === 'INVAILD_LOGIN_CREDENTIALS'

    ){
        return res.status(401).json({
            error: 'Invalid email or password'
        });
    }
if (data.error.message === 'USER_DISABLED'){
    return res.status(403).json({
        error: 'User account is disabled'
    });
}
return res.status(400).json({
    error: 'Login failed'
});
}

const user = await admin.getAuth().getUser(data.localId);
   
res.status(200).json({
    message: 'Login successful',
    data: {
        id: user.uid,
        firstName: user.displayName.split(' ')[0],
        lastName: user.displayName.split(' ')[1],
        username: user.username,
        email: user.email,
        role: user.customClaims?.role || 'user',
        token: data.idToken,
        refreshToken: data.refreshToken,
        expiresIn: data.expiresIn
    }
});

} catch (error){

    next(error);
}
   
};

const loginSSO = async (req, res, next) => {
    try {
        const { idToken } = req.body;
        if (!idToken) {
            return res.status(400).json({
                error: 'Firebase ID token is required'
            });
        }
        if (typeof idToken !== 'string') {
            return res.status(400).json({
                error: 'Firebase ID token must be a text value'
            });
        }
        const decodedToken = await admin.getAuth().verifyIdToken(idToken);
        const user = await admin.getAuth().getUser(decodedToken.uid);

        res.status(200).json({
            message: 'SSO login successful',
            data: {
                id: user.uid,
                firstName: user.displayName.split(' ')[0],
                lastName: user.displayName.split(' ')[1],
                username:user.username,
                email: user.email,
                role: user.customClaims?.role || 'user'
            }
        });
    } catch (error) {
        if(
           error.code === 'auth/id-token-expired' ||
           error.code === 'auth/argument-error'||
           error.code === 'auth/invalid-id-token' 
        ){
            return res.status(401).json({
                error: 'Invalid or expired Firebase ID token'
            });
        }
        next(error);
    }
};


